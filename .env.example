APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+pysqlite:///./data/personal.sqlite3
TMDB_API_KEY=
OPENAI_API_KEY=
DATA_DIR=./data
TMDB_CACHE_TTL_SECONDS=2592000
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_SESSION_DAYS=30
WEB_COOKIE_SECURE=false
WEB_AUTH_REQUIRED=true
WEB_LOGIN_ATTEMPTS=10
WEB_LOGIN_WINDOW_SECONDS=900
WEB_PROFILE_IMPORTS_PER_HOUR=10
RESEND_API_KEY=
EMAIL_FROM=Movie Compass <noreply@example.com>
PASSWORD_RESET_CODE_MINUTES=15
REGISTRATION_EMAIL_VERIFICATION=false
PASSWORD_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
ALLOW_SQLITE_PRODUCTION=false
