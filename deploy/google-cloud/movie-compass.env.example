APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite+pysqlite:////var/lib/movie-compass/movie-compass.sqlite3
ALLOW_SQLITE_PRODUCTION=true
DATA_DIR=/var/lib/movie-compass/data
ML_ARTIFACTS_DIR=/opt/movie-compass/ml/artifacts
TMDB_CACHE_TTL_SECONDS=2592000
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_SESSION_DAYS=30
WEB_COOKIE_SECURE=true
WEB_AUTH_REQUIRED=true
WEB_LOGIN_ATTEMPTS=10
WEB_LOGIN_WINDOW_SECONDS=900
WEB_PROFILE_IMPORTS_PER_HOUR=10
TMDB_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Movie Compass <account@movies.example.com>
PASSWORD_RESET_CODE_MINUTES=15
CLOUDFLARE_TUNNEL_TOKEN=
