[Unit]
Description=Cloudflare Tunnel for Movie Compass
After=network-online.target movie-compass.service
Wants=network-online.target

[Service]
Type=simple
User=moviecompass
Group=moviecompass
EnvironmentFile=/etc/movie-compass.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token ${CLOUDFLARE_TUNNEL_TOKEN}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
